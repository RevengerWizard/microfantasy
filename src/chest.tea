import random

import "src/level" as level

from "src/loot" import LootTable
from "src/item" import Item
from "src/coin" import Coin

export class Chest : Item
{
    new(x, y, name)
    {
        super(x, y, name)
        self.type = 'chest'
        self.isOpen = false
        const table = LootTable.new()
        table.addItem(Coin, 'coin_silver', 70)
        table.addItem(Coin, 'coin_gold', 30)
        self.lootTable = table
        self.itemCount = random.range(3, 10)
        self.lootRemaining = 0
        self.lootTimer = 0
        self.lootDelay = 0.14
    }

    function load()
    {
        super.load()
        self.empty = micro.Image.fromFile("asset/item/${self.name}_empty.png")
        self.full = micro.Image.fromFile("asset/item/${self.name}_full.png")
    }

    function loot()
    {
        const x, y = self.x, self.y - 5
        var item = self.lootTable.roll(x, y)
        if item != nil
        {
            const direction = random.random() > 0.5 ? 1 : -1
            const initialSpeed = 0.45 + random.random() * 0.45
            const upwardSpeed = 0.35 + random.random() * 0.3

            item.dx = initialSpeed * direction
            item.dy = -upwardSpeed
            self.lootRemaining -= 1
        }
    }

    function update(dt)
    {
        super.update(dt)

        if self.isOpen and self.lootRemaining > 0
        {
            self.lootTimer -= dt
            if self.lootTimer <= 0
            {
                self.loot()
                self.lootTimer = self.lootDelay
            }
        }
    }

    function open()
    {
        if not self.isOpen
        {
            self.isOpen = true
            self.image = self.empty
            self.lootRemaining = self.itemCount
            self.lootTimer = 0
        }
    }
}
