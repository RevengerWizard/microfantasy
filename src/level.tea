import math

import "lib/bump" as bump
import "lib/sti" as sti
import "lib/sti/utils" as utils

const entities = []
var player
var tilemap
var world

export function getWorld()
{
    return world
}

export function setWorld(w)
{
    world = w
}

export function addWorld(ent)
{
    world.add(ent, ent.x, ent.y, ent.w, ent.h)
}

export function filter(item, other)
{
    if other is Map
    {
        if other['type'] == 'solid' or other['type'] == 'platform'
        {
            return 'slide'
        }
    }
}

export const gravity = 9.8

from "src/enemy" import Dwarf, Oldman, Barbarian
from "src/wizard" import Wizard
from "src/potion" import Potion
from "src/chest" import Chest
from "src/key" import Key
from "src/coin" import Coin
from "src/weapon" import Sword, Axe, Bow
from "src/torch" import Torch

const entityMap = {
    wizard = Wizard,
    dwarf = Dwarf,
    oldman = Oldman,
    barbarian = Barbarian,
    potion = Potion,
    coin = Coin,
    chest = Chest,
    key = Key,
    bow = Bow,
    sword = Sword,
    axe = Axe,
    torch = Torch
}

var checkpointX = 80
var checkpointY = 55

export function setCheckpoint(x, y)
{
    checkpointX = x
    checkpointY = y
}

function resetCheckpoint()
{
    checkpointX = 80
    checkpointY = 55
}

export function getCheckpoint()
{
    return [checkpointX, checkpointY]
}

function spawn(addDefaults=false)
{
    var objects
    for const layer in tilemap.layers
    {
        if layer['type'] == 'objectgroup' and layer['name'] == 'entities'
        {
            objects = layer['objects']
            break
        }
    }
    if objects
    {
        for const v in objects
        {
            const ent = entityMap.get(v['type'])
            if ent
            {
                const x = math.round(v['x'] + v['width'] / 2)
                const y = math.round(v['y'] + v['height'] / 2)
                const obj = ent.new(x, y, v['name'])
            }
        }
    }

    if addDefaults
    {
        Bow.new(130, 70, "bow")
        Sword.new(105, 70, "sword")
        Axe.new(95, 70, "axe")
        Wizard.new(35, 40, "wizard_red_staff")
    }
}

export function load(name, addDefaults=true)
{
    const hasPlayer = player != nil
    if hasPlayer
    {
        world.remove(player)
    }
    for var i = entities.len - 1; i >= 0; i -= 1
    {
        world.remove(entities[i])
        entities.delete(i)
    }

    world = bump.newWorld(16)
    from "${name}" import data
    resetCheckpoint()
    tilemap = sti.load(utils.deepcopy(data))
    sti.plugin.bump_init(tilemap, world)
    spawn(addDefaults)

    if hasPlayer
    {
        const checkpoint = getCheckpoint()
        player.x = checkpoint[0]
        player.y = checkpoint[1]
        player.dx = 0
        player.dy = 0
        world.add(player, player.x, player.y, player.w, player.h)
    }
}

export function update(dt)
{
    player.update(dt)
    for const ent in entities
    {
        ent.update(dt)
    }
}

export function draw(x=0, y=0)
{
    tilemap.draw(x, y)
    for const ent in entities
    {
        ent.draw(x, y)
    }
    player.draw(x, y)
    if micro.keyboard.isDown('g')
    {
        sti.plugin.bump_draw(tilemap, x, y)
    }
}

export function spawnEntity(x, y, type, name)
{
    const entity = entityMap.get(type)
    if entity
    {
        entity.new(x, y, name)
    }
}

export function addEntity(ent)
{
    entities.add(ent)
}

export function addPlayer(ent)
{
    player = ent
}

export function reset()
{
    for var i = entities.len - 1; i >= 0; i -= 1
    {
        const ent = entities[i]
        world.remove(ent)
        entities.delete(i)
    }

    if player
    {
        world.remove(player)
        player = nil
    }
}

export function loadData(data, addDefaults=false)
{
    const hasPlayer = player != nil
    if hasPlayer
    {
        world.remove(player)
    }
    for var i = entities.len - 1; i >= 0; i -= 1
    {
        world.remove(entities[i])
        entities.delete(i)
    }

    world = bump.newWorld(16)
    resetCheckpoint()
    tilemap = sti.load(utils.deepcopy(data))
    sti.plugin.bump_init(tilemap, world)
    spawn(addDefaults)

    if hasPlayer
    {
        const checkpoint = getCheckpoint()
        player.x = checkpoint[0]
        player.y = checkpoint[1]
        player.dx = 0
        player.dy = 0
        world.add(player, player.x, player.y, player.w, player.h)
    }
}

export function loadMap(data)
{
    loadData(data)
}

export function getPlayer()
{
    return player
}

export function deleteEntity(ent)
{
    const idx = entities.index(ent)
    if idx != -1
    {
        entities.delete(idx)
    }
}

export function removeEntity(ent)
{
    const idx = entities.index(ent)
    if idx != -1
    {
        world.remove(ent)
        entities.delete(idx)
    }
}